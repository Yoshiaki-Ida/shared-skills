{
  "schema_version": "5.0",
  "test_cases": [
    {
      "id": "TC-01",
      "name": "宿題が後で取り消される",
      "transcript": [
        "じゃあ修正で",
        "やっぱ現行仕様で問題ないですね",
        "では対応不要で"
      ],
      "expect": {
        "type": "no_action",
        "superseded_conclusions_contains": "当初は修正方針"
      }
    },
    {
      "id": "TC-02",
      "name": "担当だけ決まる",
      "transcript": [
        "誰か調査を",
        "じゃあ私やります"
      ],
      "expect": {
        "type": "investigation",
        "assignee_speaker_id": "話者2",
        "ticket_readiness": "conditionally_ready"
      }
    },
    {
      "id": "TC-03",
      "name": "結論が反転する",
      "transcript": [
        "A案採用",
        "やっぱB案で"
      ],
      "expect": {
        "type": "decision",
        "description_contains": "B案",
        "superseded_conclusions_contains": "A案"
      }
    },
    {
      "id": "TC-04",
      "name": "同一論点が後半で再登場する",
      "transcript": [
        "メモリ増加が気になる",
        "別議題",
