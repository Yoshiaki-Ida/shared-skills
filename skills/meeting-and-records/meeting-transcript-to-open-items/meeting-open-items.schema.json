{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/meeting-open-items-v9.schema.json",
  "title": "Meeting Open Items v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting",
    "redmine_meeting_fields",
    "agenda_items",
    "meeting_summary",
    "summary",
    "items",
    "human_review_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.6"
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "datetime",
        "project",
        "participants",
        "agenda_source",
        "transcript_source",
        "extracted_at",
        "absent_people_mentioned",
        "mentioned_people"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "datetime": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "speaker_id",
              "attendance_status",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "speaker_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "attendance_status": {
                "type": "string",
                "enum": [
                  "present",
                  "absent",
                  "unknown"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "agenda_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript_source": {
          "type": "string"
        },
        "extracted_at": {
          "type": "string"
        },
        "absent_people_mentioned": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "mentioned_people": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "agenda_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AG-[0-9]{3,}$"
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_count",
        "action_item_count",
        "investigation_count",
        "finding_count",
        "unresolved_count",
        "confirmation_count",
        "hold_count",
        "no_action_count",
        "information_count",
        "ticket_ready_count",
        "needs_human_review_count"
      ],
      "properties": {
        "decision_count": {
          "type": "integer",
          "minimum": 0
        },
        "action_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "investigation_count": {
          "type": "integer",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "confirmation_count": {
          "type": "integer",
          "minimum": 0
        },
        "hold_count": {
          "type": "integer",
          "minimum": 0
        },
        "no_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "information_count": {
          "type": "integer",
          "minimum": 0
        },
        "ticket_ready_count": {
          "type": "integer",
          "minimum": 0
        },
        "needs_human_review_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "agenda_item_id",
          "title",
          "type",
          "status",
          "description",
          "rationale",
          "expected_state",
          "action_plan",
          "completion_criteria",
          "assignee",
          "assignee_speaker_id",
          "due_date",
          "next_review_timing",
          "discussion_summary",
          "superseded_conclusions",
          "possible_duplicate_of",
          "normalized_terms",
          "priority",
          "related_item_ids",
          "ticket_readiness",
          "missing_information",
          "evidence",
          "reviewer_comment",
          "source_grounding",
          "redmine_issue_fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ITEM-[0-9]{3,}$"
          },
          "agenda_item_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "decision",
              "action_item",
              "investigation",
              "finding",
              "unresolved",
              "confirmation",
              "hold",
              "no_action",
              "information",
              "question",
              "small_talk",
              "undetermined"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "waiting_confirmation",
              "pending",
              "completed",
              "no_action",
              "agreed",
              "undetermined"
            ]
          },
          "description": {
            "type": "string"
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "action_plan": {
            "type": [
              "string",
              "null"
            ]
          },
          "completion_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assignee": {
            "type": [
              "string",
              "null"
            ]
          },
          "assignee_speaker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_review_timing": {
            "type": [
              "string",
              "null"
            ]
          },
          "discussion_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "superseded_conclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "possible_duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "normalized_terms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raw",
                "normalized",
                "confidence"
              ],
              "properties": {
                "raw": {
                  "type": "string"
                },
                "normalized": {
                  "type": "string"
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                }
              }
            }
          },
          "priority": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical",
              null
            ]
          },
          "related_item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "ticket_readiness": {
            "enum": [
              "ready",
              "conditionally_ready",
              "not_ready"
            ]
          },
          "missing_information": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "timestamp",
                "speaker",
                "speaker_id",
                "summary"
              ],
              "properties": {
                "timestamp": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "summary": {
                  "type": "string"
                }
              }
            }
          },
          "reviewer_comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_grounding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "is_explicitly_stated",
              "support_level"
            ],
            "properties": {
              "is_explicitly_stated": {
                "type": "boolean"
              },
              "support_level": {
                "type": "string",
                "enum": [
                  "explicit",
                  "strongly_implied",
                  "ambiguous",
                  "unsupported"
                ]
              }
            }
          },
          "redmine_issue_fields": {
            "type": "object",
            "additionalProperties": false,
            "description": "個々の残件をRedmine子チケットへ登録するための候補項目。内容欄と専用カスタム項目の役割を分離し、全項目を保持する。不明・非該当はnullとする。",
            "required": [
              "ステータス",
              "優先度",
              "担当者",
              "対象バージョン",
              "開始日",
              "期日",
              "進捗率",
              "開発項目",
              "機能区分",
              "工程",
              "方式",
              "対象ドキュメント番号・表題",
              "処置内容",
              "確認内容",
              "確認日",
              "_2_品質特性",
              "判定",
              "判定理由"
            ],
            "properties": {
              "ステータス": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "優先度": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "担当者": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "対象バージョン": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "開始日": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "期日": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "進捗率": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "開発項目": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "機能区分": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "工程": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "方式": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "対象ドキュメント番号・表題": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "_2_品質特性": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "判定": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "判定理由": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "処置内容": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "item.action_planをRedmineの処置内容へ転記した値。発言根拠がない内容は作らない。"
              },
              "確認内容": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "item.completion_criteriaを改行区切りでRedmineの確認内容へ転記した値。"
              },
              "確認日": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "item.next_review_timingに絶対日付の根拠がある場合にYYYY-MM-DDで設定する。相対表現だけの場合はnull。"
              }
            }
          }
        }
      }
    },
    "human_review_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meeting_summary": {
      "type": "object",
      "additionalProperties": false,
      "description": "会議全体の要旨。新しいチケット候補を生成する領域ではなく、文字起こしとitemsを人間向けに俯瞰するための要約。",
      "required": [
        "overview",
        "main_topics",
        "key_outcomes",
        "open_points",
        "next_step_summary"
      ],
      "properties": {
        "overview": {
          "type": "string",
          "description": "会議全体の要旨。文字起こしとitemsに根拠がある内容だけを簡潔に記述する。"
        },
        "main_topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "会議で扱った主要論点。"
        },
        "key_outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "会議で明示的に決まったこと、対応・調査すること。"
        },
        "open_points": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "未決事項、調査中、確認待ちなど、会議終了時点で残っている論点。"
        },
        "next_step_summary": {
          "type": [
            "string",
            "null"
          ],
          "description": "会議全体として次に何をするかの要約。発言根拠がなければnull。"
        }
      }
    },
    "redmine_meeting_fields": {
      "type": "object",
      "additionalProperties": false,
      "description": "Redmineの会議・DR/CR親チケット登録候補。全項目を必ず保持し、取得不能・非該当はnullまたは空配列とする。Markdownでは値のある項目だけ表示する。",
      "required": [
        "ステータス",
        "優先度",
        "担当者",
        "対象バージョン",
        "開始日",
        "期日",
        "進捗率",
        "開発項目",
        "機能区分",
        "開催回数",
        "議事録番号",
        "工程",
        "方式",
        "対象ドキュメント番号・表題",
        "実施日",
        "実施時間(開始)",
        "実施時間(終了)",
        "DR/CR時間",
        "DR/CR工数(書面審議時)",
        "実施場所",
        "出席者(選択)_",
        "出席者(テキスト)_",
        "レビューア数",
        "DR対象頁数・ライン数(L)・項目数",
        "全体頁数・ライン数(L)・項目数",
        "手動指摘件数",
        "手動",
        "DRチェッカー",
        "_2_品質特性",
        "判定",
        "判定理由",
        "出席者"
      ],
      "properties": {
        "ステータス": {
          "type": [
            "string",
            "null"
          ]
        },
        "優先度": {
          "type": [
            "string",
            "null"
          ]
        },
        "担当者": {
          "type": [
            "string",
            "null"
          ]
        },
        "対象バージョン": {
          "type": [
            "string",
            "null"
          ]
        },
        "開始日": {
          "type": [
            "string",
            "null"
          ]
        },
        "期日": {
          "type": [
            "string",
            "null"
          ]
        },
        "進捗率": {
          "type": [
            "integer",
            "null"
          ]
        },
        "開発項目": {
          "type": [
            "string",
            "null"
          ]
        },
        "機能区分": {
          "type": [
            "string",
            "null"
          ]
        },
        "開催回数": {
          "type": [
            "integer",
            "null"
          ]
        },
        "議事録番号": {
          "type": [
            "string",
            "null"
          ]
        },
        "工程": {
          "type": [
            "string",
            "null"
          ]
        },
        "方式": {
          "type": [
            "string",
            "null"
          ]
        },
        "対象ドキュメント番号・表題": {
          "type": [
            "string",
            "null"
          ]
        },
        "実施日": {
          "type": [
            "string",
            "null"
          ]
        },
        "実施時間(開始)": {
          "type": [
            "string",
            "null"
          ]
        },
        "実施時間(終了)": {
          "type": [
            "string",
            "null"
          ]
        },
        "DR/CR時間": {
          "type": [
            "string",
            "null"
          ]
        },
        "DR/CR工数(書面審議時)": {
          "type": [
            "string",
            "null"
          ]
        },
        "実施場所": {
          "type": [
            "string",
            "null"
          ]
        },
        "出席者(選択)_": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "出席者(テキスト)_": {
          "type": [
            "string",
            "null"
          ]
        },
        "レビューア数": {
          "type": [
            "integer",
            "null"
          ]
        },
        "DR対象頁数・ライン数(L)・項目数": {
          "type": [
            "string",
            "null"
          ]
        },
        "全体頁数・ライン数(L)・項目数": {
          "type": [
            "string",
            "null"
          ]
        },
        "手動指摘件数": {
          "type": [
            "integer",
            "null"
          ]
        },
        "手動": {
          "type": [
            "string",
            "null"
          ]
        },
        "DRチェッカー": {
          "type": [
            "string",
            "null"
          ]
        },
        "_2_品質特性": {
          "type": [
            "string",
            "null"
          ]
        },
        "判定": {
          "type": [
            "string",
            "null"
          ]
        },
        "判定理由": {
          "type": [
            "string",
            "null"
          ]
        },
        "出席者": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}